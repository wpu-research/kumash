# Boşsa geliştirmede gömülü Postgres (PGlite, ./.data) kullanılır. Railway'de Postgres URL'si.
DATABASE_URL=
# Yönetim paneli şifresi ve oturum imzası
ADMIN_PASSWORD=kumash
SESSION_SECRET=degistir-beni
# Claude API: anahtar tanımlıysa çekimler Claude (claude-opus-5-5) ile işlenir
ANTHROPIC_API_KEY=
# AI sağlayıcısı: boş = anahtar varsa claude, yoksa mock. Zorlamak için: claude | mock
AI_PROVIDER=
# Trendyol Partner API — boşsa yayın "kimlik bekleniyor" olarak işaretlenir
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
# Instagram Graph API — boşsa yayın "kimlik bekleniyor" olarak işaretlenir
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=
# Yüklenen fotoğrafların klasörü (Railway'de volume yolu)
UPLOAD_DIR=./uploads

# Facebook sayfa gönderisi ve Meta kataloğu (boşsa kanal "hesap bağlı değil" görünür)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
