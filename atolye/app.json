{
  "expo": {
    "name": "Kumash Atölye",
    "slug": "kumash-atolye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kumash-atolye",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kumash.atolye",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kumash.atolye",
      "adaptiveIcon": {
        "backgroundColor": "#12141B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12141B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Atölye, ürünlerin fotoğrafını çekmek için kamerayı kullanır.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Atölye, daha önce çektiğin ürün fotoğraflarını seçebilmen için galeriye erişir.",
          "cameraPermission": "Atölye, ürünlerin fotoğrafını çekmek için kamerayı kullanır.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ef929870-7634-4147-b8d3-c6635dc2f21d"
      },
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "storeUrl": "https://kumash.com"
    },
    "owner": "wpu-research"
  }
}
